# Wallet
PRIVATE_KEY=

# Connection (Outsmart also reads MAINNET_ENDPOINT — mirrored from RPC_ENDPOINT at runtime)
# For a single RPC:
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
MAINNET_ENDPOINT=https://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# Multi-key load spreading (recommended for Helius free/shared keys):
# One API key or full HTTPS URL per line. File is gitignored as rpc-keys.local.txt.
# When 2+ keys are loaded the bot starts a local HTTP proxy that round-robins
# getTransaction / sendTransaction across all keys, and assigns each stream
# preset its own WebSocket key.
# RPC_KEYS_FILE=rpc-keys.local.txt
# RPC_PROXY_PORT=18789
# Or comma-separated: RPC_ENDPOINTS=https://...,https://...

# Outsmart multi-DEX adapters (comma-separated).
# Full list: raydium-amm-v4,raydium-cpmm,raydium-clmm,raydium-launchlab,
# meteora-damm-v1,meteora-damm-v2,meteora-dlmm,meteora-dbc,
# pumpfun,pumpfun-amm,orca,byreal-clmm,pancakeswap-clmm,fusion-amm,futarchy-amm,
# jupiter-ultra,dflow
ENABLED_DEXES=pumpfun-amm,raydium-cpmm,raydium-amm-v4,raydium-launchlab,pumpfun,meteora-damm-v2,meteora-dbc,jupiter-ultra

# Stream presets (comma-separated): new-pools,pumpswap,raydium,meteora,pumpfun-bonding,all-dex-swaps,other-dexes
# Use a private RPC if you enable many presets — public mainnet WS will 429.
STREAM_PRESETS=new-pools,pumpswap,raydium

# Bot
LOG_LEVEL=info
ONE_TOKEN_AT_A_TIME=true
AUTO_BUY=true
COMPUTE_UNIT_LIMIT=400000
COMPUTE_UNIT_PRICE=421197
# Optional MEV tip for Outsmart landing (0 = no tip). Never uses Warp.
TIP_SOL=0
# TX_LANDING_MODE=concurrent

# Buy
QUOTE_MINT=WSOL
QUOTE_AMOUNT=0.001
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=3
BUY_SLIPPAGE=20

# Sell
AUTO_SELL=false
MAX_SELL_RETRIES=3
AUTO_SELL_DELAY=0
# When AUTO_SELL=true, hold this many ms before selling (reuses PRICE_CHECK_DURATION)
PRICE_CHECK_INTERVAL=2000
PRICE_CHECK_DURATION=0
TAKE_PROFIT=40
STOP_LOSS=20
SELL_SLIPPAGE=20

# Legacy Raydium-v4 pool filters (optional; off by default with Outsmart multi-DEX)
ENABLE_LEGACY_FILTERS=false
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
CONSECUTIVE_FILTER_MATCHES=3
CHECK_IF_MUTABLE=false
CHECK_IF_SOCIALS=false
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=false
CHECK_IF_BURNED=true
MIN_POOL_SIZE=0
MAX_POOL_SIZE=0
